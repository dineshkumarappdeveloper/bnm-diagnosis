-- Per-parameter results. EMPTY rows (value NULL) are pre-created for every
-- parameter of every ordered test at order time, so the worklist/entry grid is
-- driven by this table alone. flag: N/L/H/CL/CH numeric, A = abnormal
-- qualitative; ref_display = the range exactly as it prints on the report
-- (frozen at entry time against the patient's then-age/sex). The entered/
-- verified/approved audit trio is a legal requirement (pathologist sign-off).

CREATE TABLE IF NOT EXISTS lab_results (
    id TEXT NOT NULL PRIMARY KEY,
    order_id TEXT NOT NULL,
    test_id TEXT NOT NULL,
    parameter_key TEXT NOT NULL,
    value TEXT,                         -- NULL/'' = not entered yet
    unit TEXT,
    flag TEXT,                          -- 'N'|'L'|'H'|'CL'|'CH'|'A' | NULL
    ref_display TEXT,
    notes TEXT,
    entered_by TEXT,
    entered_at TEXT,
    verified_by TEXT,
    verified_at TEXT,
    approved_by TEXT,
    approved_at TEXT,
    -- staff.id of the signatories, stamped at verify/approve (2026-09-07). The
    -- NAME above is what prints; the id is what the report uses to fetch THAT
    -- person's signature, so a namesake hired later never lends their ink.
    -- NULL on rows written before then (name-matched, as before). Appended
    -- last: AppDatabaseFactory adds them positionally on existing DBs.
    verified_by_id TEXT,
    approved_by_id TEXT,
    -- When THIS row went out on a printed/shared report (2026-09-11). Per row
    -- like the other stamps, so a test released ahead of the rest of its order
    -- (outsourced lines still pending) keeps its own reported time, and the
    -- order's reported_at becomes the moment the LAST test went out. Appended
    -- last: AppDatabaseFactory adds it positionally on existing DBs.
    reported_at TEXT
);

CREATE UNIQUE INDEX IF NOT EXISTS lab_results_key ON lab_results(order_id, test_id, parameter_key);
CREATE INDEX IF NOT EXISTS lab_results_order ON lab_results(order_id);

-- Pre-create the empty grid row at order time (idempotent).
insertEmpty:
INSERT OR IGNORE INTO lab_results(id, order_id, test_id, parameter_key, value, unit, flag, ref_display, notes, entered_by, entered_at, verified_by, verified_at, approved_by, approved_at)
VALUES (?, ?, ?, ?, NULL, ?, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

insertResult:
INSERT INTO lab_results(id, order_id, test_id, parameter_key, value, unit, flag, ref_display, notes, entered_by, entered_at, verified_by, verified_at, approved_by, approved_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, NULL, NULL, NULL);

updateValue:
UPDATE lab_results
SET value = ?, unit = ?, flag = ?, ref_display = ?, entered_by = ?, entered_at = ?
WHERE order_id = ? AND test_id = ? AND parameter_key = ?;

byKey:
SELECT * FROM lab_results WHERE order_id = ? AND test_id = ? AND parameter_key = ?;

resultsForOrder:
SELECT * FROM lab_results WHERE order_id = ? ORDER BY rowid;

resultsForOrderTest:
SELECT * FROM lab_results WHERE order_id = ? AND test_id = ? ORDER BY rowid;

countEmptyForOrder:
SELECT count(*) FROM lab_results WHERE order_id = ? AND (value IS NULL OR value = '');

countEmptyForTest:
SELECT count(*) FROM lab_results WHERE order_id = ? AND test_id = ? AND (value IS NULL OR value = '');

-- Order-wide sign-off. A row already signed (per-test release) keeps its
-- stamp: a signature is never overwritten by a later, broader sign-off.
markVerified:
UPDATE lab_results SET verified_by = ?, verified_at = ?, verified_by_id = ? WHERE order_id = ? AND verified_at IS NULL;

markApproved:
UPDATE lab_results SET approved_by = ?, approved_at = ?, approved_by_id = ? WHERE order_id = ? AND approved_at IS NULL;

-- Per-test sign-off and release (2026-09-11): the same stamps, one test at a time.
markVerifiedForTest:
UPDATE lab_results SET verified_by = ?, verified_at = ?, verified_by_id = ? WHERE order_id = ? AND test_id = ? AND verified_at IS NULL;

markApprovedForTest:
UPDATE lab_results SET approved_by = ?, approved_at = ?, approved_by_id = ? WHERE order_id = ? AND test_id = ? AND approved_at IS NULL;

markReportedForTest:
UPDATE lab_results SET reported_at = ? WHERE order_id = ? AND test_id = ? AND reported_at IS NULL;

-- Signatory-id backfill: rows stamped before ids existed carry only the
-- display name. Where that name is one staff member's, the id is filled in so
-- a reprint follows the PERSON (current name, signature) rather than the name
-- as it was typed then.
backfillVerifiedById:
UPDATE lab_results SET verified_by_id = ? WHERE verified_by_id IS NULL AND lower(trim(verified_by)) = lower(trim(?));

backfillApprovedById:
UPDATE lab_results SET approved_by_id = ? WHERE approved_by_id IS NULL AND lower(trim(approved_by)) = lower(trim(?));

setNotes:
UPDATE lab_results SET notes = ? WHERE order_id = ? AND test_id = ? AND parameter_key = ?;

-- Dashboard: today's CRITICAL results (CL/CH) with patient identity + phone
-- joined — labs must phone criticals out. entered_at is an ISO instant; the
-- caller passes today's local date (yyyy-MM-dd).
criticalsToday:
SELECT r.order_id, r.test_id, r.parameter_key, r.value, r.unit, r.flag,
       o.accession_no, p.name AS patient_name, p.phone AS patient_phone
FROM lab_results r
JOIN lab_orders o ON o.id = r.order_id
JOIN patients p ON p.id = o.patient_id
WHERE r.flag IN ('CL', 'CH') AND substr(r.entered_at, 1, 10) = :today
ORDER BY r.entered_at DESC
LIMIT :limit;

-- Same card, TIMEZONE-CORRECT (P4). `criticalsToday` compares a UTC instant's
-- date prefix against the operator's LOCAL date, so an IST lab's criticals card
-- goes blank between local midnight and 05:30 — exactly the night shift where
-- a call-out matters. This takes the half-open UTC instant bounds of the local
-- day instead (LabRepository.instantBounds).
criticalsBetween:
SELECT r.order_id, r.test_id, r.parameter_key, r.value, r.unit, r.flag,
       o.accession_no, p.name AS patient_name, p.phone AS patient_phone
FROM lab_results r
JOIN lab_orders o ON o.id = r.order_id
JOIN patients p ON p.id = o.patient_id
WHERE r.flag IN ('CL', 'CH')
  AND r.entered_at >= :from AND r.entered_at < :toExclusive
ORDER BY r.entered_at DESC
LIMIT :limit;

-- ── P3 sync ──

-- Push sweep: orders whose result bundle changed since the watermark.
changedResultOrders:
SELECT DISTINCT order_id FROM lab_results
WHERE (entered_at IS NOT NULL AND entered_at > :since)
   OR (verified_at IS NOT NULL AND verified_at > :since)
   OR (approved_at IS NOT NULL AND approved_at > :since)
   OR (reported_at IS NOT NULL AND reported_at > :since);

-- Pull apply: whole-row upsert of one remote result. INSERT OR REPLACE also
-- resolves a (order,test,param) unique-index clash against a locally-minted
-- empty row (the remote row id wins; ids are internal).
upsertFull:
INSERT OR REPLACE INTO lab_results(id, order_id, test_id, parameter_key, value, unit, flag, ref_display, notes, entered_by, entered_at, verified_by, verified_at, approved_by, approved_at, verified_by_id, approved_by_id, reported_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
