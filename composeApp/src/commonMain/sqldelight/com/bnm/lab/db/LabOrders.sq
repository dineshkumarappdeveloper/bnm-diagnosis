-- Lab orders (one accession = one patient visit's sample set) + the tests on
-- each order (name/price snapshotted at order time so later catalog edits
-- never rewrite history). Status is a linear pipeline:
-- registered → collected → in_progress → entered → verified → approved →
-- reported → delivered (+ cancelled). Guards live in LabRepository.

CREATE TABLE IF NOT EXISTS lab_orders (
    id TEXT NOT NULL PRIMARY KEY,
    accession_no TEXT NOT NULL UNIQUE,   -- ACC-S1-00042 (per-seat, never-rewind)
    patient_id TEXT NOT NULL,
    referrer_id TEXT,
    invoice_id TEXT,                     -- links the GST bill (ecom_entity invoice)
    status TEXT NOT NULL DEFAULT 'registered',
    priority TEXT NOT NULL DEFAULT 'routine',   -- routine | urgent | stat
    notes TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    collected_at TEXT,
    approved_at TEXT,
    reported_at TEXT
);

CREATE INDEX IF NOT EXISTS lab_orders_status ON lab_orders(status, created_at);
CREATE INDEX IF NOT EXISTS lab_orders_patient ON lab_orders(patient_id, created_at);

CREATE TABLE IF NOT EXISTS lab_order_tests (
    id TEXT NOT NULL PRIMARY KEY,
    order_id TEXT NOT NULL,
    test_id TEXT NOT NULL,
    test_name TEXT NOT NULL,             -- snapshot at order time
    price REAL NOT NULL DEFAULT 0,       -- snapshot at order time
    status TEXT NOT NULL DEFAULT 'pending',  -- pending | in_progress | entered
    -- Commission % RESOLVED at registration and frozen here, beside the price
    -- that is already frozen. Round-1 fix: the percentage used to be read live
    -- off the referrers row when a statement was generated, so renegotiating a
    -- doctor's rate silently rewrote every past month's payout.
    commission_pct REAL NOT NULL DEFAULT 0,
    -- L3 outsourced workflow: when the sample left for the partner lab. A
    -- lightweight stamp beside the pipeline, NOT a new LabStatus stage — the
    -- order keeps walking registered → … → approved exactly as before.
    sent_to_partner_at TEXT
);

CREATE INDEX IF NOT EXISTS lab_order_tests_order ON lab_order_tests(order_id);

-- ── Orders ──

insertOrder:
INSERT INTO lab_orders(id, accession_no, patient_id, referrer_id, invoice_id, status, priority, notes, created_at, updated_at, collected_at, approved_at, reported_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, NULL, NULL);

byId:
SELECT * FROM lab_orders WHERE id = ?;

byAccession:
SELECT * FROM lab_orders WHERE accession_no = ?;

-- Worklist for one pipeline stage, joined with the patient (name/sex/age drive
-- both the list row and range resolution) + how many tests ride the order.
worklistByStatus:
SELECT o.*, p.name AS patient_name, p.sex AS patient_sex, p.dob AS patient_dob, p.age_years AS patient_age_years,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id
          AND NOT EXISTS (SELECT 1 FROM lab_results r
                          WHERE r.order_id = o.id AND r.test_id = t.test_id
                            AND (r.value IS NULL OR trim(r.value) = ''))) AS done_count,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id) AS test_count,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id
          AND EXISTS (SELECT 1 FROM lab_results r
                      WHERE r.order_id = o.id AND r.test_id = t.test_id AND r.reported_at IS NOT NULL)) AS reported_count
FROM lab_orders o
JOIN patients p ON p.id = o.patient_id
WHERE o.status = ?
ORDER BY o.created_at DESC;

ordersForPatient:
SELECT * FROM lab_orders WHERE patient_id = ? ORDER BY created_at DESC;

setStatus:
UPDATE lab_orders SET status = ?, updated_at = ? WHERE id = ?;

stampCollected:
UPDATE lab_orders SET collected_at = ? WHERE id = ?;

stampApproved:
UPDATE lab_orders SET approved_at = ? WHERE id = ?;

stampReported:
UPDATE lab_orders SET reported_at = ? WHERE id = ?;

linkInvoice:
UPDATE lab_orders SET invoice_id = ?, updated_at = ? WHERE id = ?;

-- Worklist tab badges: ONE reactive rollup — live row count per status
-- (cancelled excluded). The UI derives Open/Registered sums from the map.
countsByStatus:
SELECT status, count(*) AS n FROM lab_orders WHERE status != 'cancelled' GROUP BY status;

-- Dashboard worklist: every order still moving through the pipeline (any day),
-- newest first, capped. Approved-but-not-yet-reported stays visible; reported/
-- delivered/cancelled are terminal for the home dashboard.
openOrders:
SELECT o.*, p.name AS patient_name, p.sex AS patient_sex, p.dob AS patient_dob, p.age_years AS patient_age_years,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id
          AND NOT EXISTS (SELECT 1 FROM lab_results r
                          WHERE r.order_id = o.id AND r.test_id = t.test_id
                            AND (r.value IS NULL OR trim(r.value) = ''))) AS done_count,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id) AS test_count,
       (SELECT count(*) FROM lab_order_tests t WHERE t.order_id = o.id
          AND EXISTS (SELECT 1 FROM lab_results r
                      WHERE r.order_id = o.id AND r.test_id = t.test_id AND r.reported_at IS NOT NULL)) AS reported_count
FROM lab_orders o
JOIN patients p ON p.id = o.patient_id
WHERE o.status IN ('registered', 'collected', 'in_progress', 'entered', 'verified', 'approved')
ORDER BY o.created_at DESC
LIMIT :limit;

-- The orders an unmatched analyzer result may be assigned to (the claim
-- picker). Patient identity rides along because the operator picks by NAME —
-- that is the whole point of the picker — and the ordered test ids come with it
-- so the caller can rank each order by how many of the frame's parameters those
-- tests actually take.
--
-- Locked orders (approved and past) are INCLUDED so the caller can say how many
-- it is holding back; cancelled ones are not, because a withdrawn order is not
-- waiting for results at all. Typing its accession by hand still reaches it,
-- and the engine refuses it there with the same "results are locked" message.
--
-- The SEARCH is here rather than in the caller on purpose. :limit is a window on
-- the newest orders, and a lab registering a hundred a day pushes this morning's
-- out of it by mid-afternoon; filtering an already-fetched window would then
-- answer "nothing matches" for a patient who is plainly in the system, which is
-- exactly how a duplicate registration (and a duplicate bill) happens. A blank
-- :q is the unfiltered ranked window. :digits is :q reduced to digits, blank
-- when the caller judged it too short to be a phone — the phone column is
-- stripped the same way so '98765' finds '+91 98765 43210'. LIKE is
-- case-insensitive for ASCII, which is what the accession and the name need.
claimCandidates:
SELECT o.id, o.accession_no, o.status, o.created_at,
       p.name AS patient_name, p.sex AS patient_sex, p.dob AS patient_dob,
       p.age_years AS patient_age_years, p.phone AS patient_phone,
       (SELECT group_concat(t.test_name, ' · ') FROM lab_order_tests t WHERE t.order_id = o.id) AS test_names,
       (SELECT group_concat(t.test_id, ',') FROM lab_order_tests t WHERE t.order_id = o.id) AS test_ids
FROM lab_orders o
JOIN patients p ON p.id = o.patient_id
WHERE o.status != 'cancelled'
  AND (:q = ''
       OR o.accession_no LIKE '%' || :q || '%'
       OR p.name LIKE '%' || :q || '%'
       OR (:digits != '' AND replace(replace(replace(coalesce(p.phone, ''), ' ', ''), '+', ''), '-', '')
             LIKE '%' || :digits || '%'))
ORDER BY o.created_at DESC
LIMIT :limit;

-- ── P3 sync ──

-- Push sweep: orders touched since the watermark (every mutation bumps updated_at).
changedSince:
SELECT * FROM lab_orders WHERE updated_at > :since;

-- Pull apply: whole-row upsert of a remote order doc (guards live in LabSyncEngine).
upsertOrder:
INSERT OR REPLACE INTO lab_orders(id, accession_no, patient_id, referrer_id, invoice_id, status, priority, notes, created_at, updated_at, collected_at, approved_at, reported_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Pull apply: the incoming doc's embedded test lines replace the local set.
deleteTestsForOrder:
DELETE FROM lab_order_tests WHERE order_id = ?;

-- ── P4 referrer commissions ──
--
-- Gross billed per referrer over a date range, summed from the LINE-ITEM
-- SNAPSHOTS (lab_order_tests.price) — those are the historical truth: they
-- already carry the referrer's negotiated rate as it stood at registration,
-- so re-pricing the catalog or the rate list never rewrites a past statement.
-- Cancelled orders are excluded; orders with no referrer never appear.
-- Bounds are ISO instants, :from inclusive / :toExclusive exclusive (the
-- caller converts the operator's LOCAL date range to UTC instants).
-- `payable` is summed PER LINE from the commission_pct frozen on that line, not
-- from the referrer's current rate. Round-1 fix: the caller used to multiply
-- gross by the LIVE referrers.commission_pct, so renegotiating a doctor's rate
-- silently restated every past month. Per-line summing is also what makes a
-- per-test override meaningful — two tests on one order can pay differently.
commissionByReferrer:
SELECT o.referrer_id AS referrer_id,
       count(DISTINCT o.id) AS orders_count,
       coalesce(sum(t.price), 0.0) AS gross,
       coalesce(sum(t.price * t.commission_pct / 100.0), 0.0) AS payable
FROM lab_orders o
LEFT JOIN lab_order_tests t ON t.order_id = o.id
WHERE o.referrer_id IS NOT NULL
  AND o.status != 'cancelled'
  AND o.created_at >= :from AND o.created_at < :toExclusive
GROUP BY o.referrer_id;

-- Per-TEST breakdown for one referrer's statement (feedback item 7: "well
-- detail"). Same snapshot discipline, grouped by test instead of by referrer.
commissionByTestForReferrer:
SELECT t.test_id AS test_id,
       t.test_name AS test_name,
       count(*) AS times_ordered,
       coalesce(sum(t.price), 0.0) AS gross,
       coalesce(sum(t.price * t.commission_pct / 100.0), 0.0) AS payable
FROM lab_orders o
JOIN lab_order_tests t ON t.order_id = o.id
WHERE o.referrer_id = :referrerId
  AND o.status != 'cancelled'
  AND o.created_at >= :from AND o.created_at < :toExclusive
GROUP BY t.test_id, t.test_name
ORDER BY payable DESC;

-- Lab-wide month-to-date rollup for the dashboard tile.
commissionTotals:
SELECT coalesce(sum(t.price), 0.0) AS gross,
       coalesce(sum(t.price * t.commission_pct / 100.0), 0.0) AS payable,
       count(DISTINCT o.id) AS orders_count
FROM lab_orders o
JOIN lab_order_tests t ON t.order_id = o.id
WHERE o.referrer_id IS NOT NULL
  AND o.status != 'cancelled'
  AND o.created_at >= :from AND o.created_at < :toExclusive;

-- Drill-down: one referrer's orders inside the same range, newest first.
referrerOrdersInRange:
SELECT o.id AS order_id, o.accession_no, o.created_at, o.reported_at, o.status, o.invoice_id,
       p.name AS patient_name,
       coalesce(sum(t.price), 0.0) AS amount
FROM lab_orders o
JOIN patients p ON p.id = o.patient_id
LEFT JOIN lab_order_tests t ON t.order_id = o.id
WHERE o.referrer_id = :referrerId
  AND o.status != 'cancelled'
  AND o.created_at >= :from AND o.created_at < :toExclusive
GROUP BY o.id
ORDER BY o.created_at DESC;

-- ── Order tests ──

insertOrderTest:
INSERT INTO lab_order_tests(id, order_id, test_id, test_name, price, status, commission_pct, sent_to_partner_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Does any order still name this test? The legacy-seed sweep deletes a
-- starter-catalog row outright when nothing does, and only then.
countOrderTestsFor:
SELECT count(*) FROM lab_order_tests WHERE test_id = ?;

-- Revenue dashboard: every test line of every order registered in a window.
-- Callers pass a window WIDER than the days they report on and trim by LOCAL
-- date in Kotlin. created_at strings carry variable sub-second precision, so a
-- lexical bound of '…T18:30:00Z' sorts AFTER '…T18:30:00.807Z' and would push
-- the first order of an IST day into the day before.
revenueLines:
SELECT o.id AS order_id, o.created_at, o.status, o.referrer_id, o.invoice_id,
       t.test_id, t.test_name, t.price, t.commission_pct
FROM lab_orders o JOIN lab_order_tests t ON t.order_id = o.id
WHERE o.created_at >= :fromInstant AND o.created_at < :toInstant;

-- Which bills are LAB bills: anything an order links to, whenever it was made.
-- A connected lab's business can also hold counter (C1) and sales (S1) bills
-- from BNM Billing and BNM Admin, and those are not the lab's revenue.
linkedInvoiceIds:
SELECT DISTINCT invoice_id FROM lab_orders WHERE invoice_id IS NOT NULL;

testsForOrder:
SELECT * FROM lab_order_tests WHERE order_id = ? ORDER BY rowid;

setOrderTestStatus:
UPDATE lab_order_tests SET status = ? WHERE order_id = ? AND test_id = ?;

-- L3: stamp the "Sent to partner" step on one outsourced line.
markSentToPartner:
UPDATE lab_order_tests SET sent_to_partner_at = ? WHERE order_id = ? AND test_id = ?;

-- L3: bump the order's LWW stamp without walking status (the sent-to-partner
-- stamp must reach the lab's other seats through the ordinary push sweep).
touchOrder:
UPDATE lab_orders SET updated_at = ? WHERE id = ?;
