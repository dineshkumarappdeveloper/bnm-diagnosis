-- Generic offline document store for ecommerce entities
-- (entity ∈ 'order' | 'product' | 'category' | 'ledger').
-- The full server JSON is kept in `json`; id/seq/created_at are extracted for
-- the cursor + ordering. Soft-deleted rows are removed locally during sync.

CREATE TABLE IF NOT EXISTS ecom_entity (
    entity TEXT NOT NULL,
    id TEXT NOT NULL,
    business_id TEXT NOT NULL,
    seq INTEGER NOT NULL DEFAULT 0,
    created_at TEXT,
    json TEXT NOT NULL,
    PRIMARY KEY (entity, id)
);

CREATE INDEX IF NOT EXISTS ecom_entity_list ON ecom_entity(entity, business_id, created_at);

selectEntity:
SELECT json FROM ecom_entity
WHERE entity = ? AND business_id = ?
ORDER BY created_at DESC;

-- Several businesses at once — a balance read spans the lab's business AND the
-- offline archive (BillingScope.readScopes), so bills issued before a move to
-- the connected edition stay visible after it.
selectEntityIn:
SELECT business_id, json FROM ecom_entity
WHERE entity = :entity AND business_id IN :businessIds
ORDER BY created_at DESC;

selectById:
SELECT json FROM ecom_entity WHERE entity = ? AND id = ?;

-- The server seq a stored row carries (0 for a row written optimistically on
-- this device). A pull compares against it so it never replaces a newer row.
seqOf:
SELECT seq FROM ecom_entity WHERE entity = ? AND id = ?;

upsertEntity:
INSERT OR REPLACE INTO ecom_entity(entity, id, business_id, seq, created_at, json)
VALUES (?, ?, ?, ?, ?, ?);

deleteEntity:
DELETE FROM ecom_entity WHERE entity = ? AND id = ?;

clearAllEntities:
DELETE FROM ecom_entity;

-- Offline installs filed their bills under the literal business id 'null' (a
-- licence-claim parsing bug); move them to the offline archive key.
rekeyNullBusinessEntities:
UPDATE ecom_entity SET business_id = ? WHERE business_id = 'null';

-- "Clear & re-sync" keeps rows no server holds a copy of: an offline-edition
-- bill wiped here is gone for good, because there is nothing to re-sync from.
clearEntitiesExcept:
DELETE FROM ecom_entity WHERE business_id != ?;

countEntity:
SELECT count(*) FROM ecom_entity WHERE entity = ? AND business_id = ?;

-- Dashboard: rows created today (created_at is ISO; caller passes yyyy-MM-dd).
countEntityToday:
SELECT count(*) FROM ecom_entity
WHERE entity = ? AND business_id = ? AND substr(created_at, 1, 10) = ?;
