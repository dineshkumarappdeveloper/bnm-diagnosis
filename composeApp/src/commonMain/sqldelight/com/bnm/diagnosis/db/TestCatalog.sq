-- Test catalog: every orderable test with its parameters embedded as JSON
-- (parameters_json = [{key, name, unit, decimals, ranges:[{sex?, ageMinY?,
-- ageMaxY?, low?, high?, criticalLow?, criticalHigh?, text?}]}]) — the Kotlin
-- layer (LabModels/LabRepository) is the only reader/writer of that JSON.
-- Panels are priced bundles of test ids (test_ids_json = ["..."]).

CREATE TABLE lab_tests (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,           -- short order code, e.g. 'CBC'
    name TEXT NOT NULL,
    category TEXT,                       -- Hematology / Biochemistry / ...
    price REAL NOT NULL DEFAULT 0,
    sample_type TEXT NOT NULL DEFAULT 'blood',  -- blood|serum|urine|stool|swab|other
    method TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0,
    parameters_json TEXT NOT NULL,
    -- ── L3 platform catalog import (all NULL for locally-authored tests) ──
    platform_product_id TEXT,            -- products.id this test was imported from
    fulfillment TEXT,                    -- 'in_house' | 'outsourced' (NULL = in-house)
    outsource_partner TEXT,              -- partner lab name (outsourced only)
    outsource_cost REAL,                 -- what the partner charges (margin = L4)
    tat_hours REAL,                      -- promised turnaround, from lab_config
    platform_json TEXT                   -- the product's lab_config verbatim (lossless)
);

CREATE TABLE lab_panels (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    price REAL NOT NULL DEFAULT 0,
    test_ids_json TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 1
);

-- ── Tests ──

upsertTest:
INSERT OR REPLACE INTO lab_tests(id, code, name, category, price, sample_type, method, active, sort_order, parameters_json, platform_product_id, fulfillment, outsource_partner, outsource_cost, tat_hours, platform_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

testById:
SELECT * FROM lab_tests WHERE id = ?;

testByCode:
SELECT * FROM lab_tests WHERE code = ?;

-- L3: the imported copy of one platform product (origin marker lookup).
testByPlatformProduct:
SELECT * FROM lab_tests WHERE platform_product_id = ?;

-- L3: every imported test — the deactivate-on-disappearance sweep reads this.
listPlatformTests:
SELECT * FROM lab_tests WHERE platform_product_id IS NOT NULL;

listTests:
SELECT * FROM lab_tests WHERE active = 1 ORDER BY sort_order, name;

listAllTests:
SELECT * FROM lab_tests ORDER BY sort_order, name;

setTestActive:
UPDATE lab_tests SET active = ? WHERE id = ?;

deleteTest:
DELETE FROM lab_tests WHERE id = ?;

countTests:
SELECT count(*) FROM lab_tests;

-- ── Panels ──

upsertPanel:
INSERT OR REPLACE INTO lab_panels(id, code, name, price, test_ids_json, active)
VALUES (?, ?, ?, ?, ?, ?);

panelById:
SELECT * FROM lab_panels WHERE id = ?;

listPanels:
SELECT * FROM lab_panels WHERE active = 1 ORDER BY name;

listAllPanels:
SELECT * FROM lab_panels ORDER BY name;

setPanelActive:
UPDATE lab_panels SET active = ? WHERE id = ?;

deletePanel:
DELETE FROM lab_panels WHERE id = ?;

countPanels:
SELECT count(*) FROM lab_panels;
